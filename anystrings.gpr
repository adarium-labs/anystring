with "config/anystrings_config.gpr";
project Anystrings is

   for Library_Name use "Anystring";
   for Library_Version use Project'Library_Name & ".so." & Anystrings_Config.Crate_Version;

   ---------------------------------------------------------------------------
   --  String Type Selection
   ---------------------------------------------------------------------------
   --  Use environment variable STRING_TYPE to select the string type:
   --    - "standard"        : Ada.Strings.Unbounded.Unbounded_String (default)
   --    - "wide_string"     : Ada.Strings.Wide_Unbounded.Unbounded_Wide_String
   --    - "wide_wide_string": Ada.Strings.Wide_Wide_Unbounded.Unbounded_Wide_Wide_String
   --    - "uxstring"        : UXStrings.UXString (requires uxstrings dependency)
   --    - "custom"          : Use STRING_PATH to specify custom path
   --
   --  Example usage:
   --    STRING_TYPE=wide_string alr build
   --    STRING_TYPE=wide_string ANYSTRING_WIDE_ENV_ENCODING=latin_1 alr build
   --    STRING_TYPE=custom STRING_PATH=/path/to/my/strings alr build

   type String_Type_Choice is
     ("standard", "wide_string", "wide_wide_string", "uxstring", "vss", "custom");
   String_Type : String_Type_Choice :=
     external ("STRING_TYPE", "standard");

   type Wide_Env_Encoding_Choice is ("utf_8", "latin_1");
   Wide_Env_Encoding : Wide_Env_Encoding_Choice :=
     external ("ANYSTRING_WIDE_ENV_ENCODING", "utf_8");

   ---------------------------------------------------------------------------
   --  Display-Width opt-in (ANYSTRING_WITH_WIDTH)
   ---------------------------------------------------------------------------
   --  When "false" (default), the per-backend *_width.{ads,adb} and
   --  string_types-width.ads files are excluded from compilation so that
   --  umwi never enters the closure (NFR-WIDTH-001, NFR-WIDTH-002).
   --  When "true", those files are included and umwi is a dependency.
   --  Example: ANYSTRING_WITH_WIDTH=true alr build

   type With_Width_Choice is ("true", "false");
   With_Width : With_Width_Choice :=
     external ("ANYSTRING_WITH_WIDTH", "false");

   String_Source_Dirs := ();
   case String_Type is
      when "standard" =>
         String_Source_Dirs := ("src/strings/standard");
      when "wide_string" =>
         String_Source_Dirs := ("src/strings/wide_string");
      when "wide_wide_string" =>
         String_Source_Dirs := ("src/strings/wide_wide_string");
      when "uxstring" =>
         String_Source_Dirs := ("src/strings/uxstring");
      when "vss" =>
         String_Source_Dirs := ("src/strings/vss");
      when "custom" =>
         String_Source_Dirs := (external ("STRING_PATH", ""));
   end case;

   Wide_Env_Encoding_Source_Dirs := ();
   case Wide_Env_Encoding is
      when "utf_8" =>
         Wide_Env_Encoding_Source_Dirs := ("src/strings/wide_env_encoding/utf_8");
      when "latin_1" =>
         Wide_Env_Encoding_Source_Dirs := ("src/strings/wide_env_encoding/latin_1");
   end case;

   Wide_Env_Output_Suffix := "";
   case String_Type is
      when "wide_string" | "wide_wide_string" =>
         Wide_Env_Output_Suffix := "/" & external ("ANYSTRING_WIDE_ENV_ENCODING", "utf_8");
      when others =>
         null;
   end case;

   Width_Excluded := ();
   case With_Width is
      when "false" =>
         case String_Type is
            when "standard" =>
               Width_Excluded := ("standard_width.ads", "standard_width.adb", "string_types-width.ads");
            when "wide_string" =>
               Width_Excluded := ("wide_width.ads", "wide_width.adb", "string_types-width.ads");
            when "wide_wide_string" =>
               Width_Excluded := ("wide_wide_width.ads", "wide_wide_width.adb", "string_types-width.ads");
            when "uxstring" =>
               Width_Excluded := ("uxstring_width.ads", "uxstring_width.adb", "string_types-width.ads");
            when "vss" =>
               Width_Excluded := ("vss_width.ads", "vss_width.adb", "string_types-width.ads");
            when "custom" =>
               null;
         end case;
      when "true" =>
         null;
   end case;
   for Excluded_Source_Files use Width_Excluded;

   for Source_Dirs use ("src/", "config/") & String_Source_Dirs & Wide_Env_Encoding_Source_Dirs;
   for Object_Dir use
     "obj/" & external ("STRING_TYPE", "standard") & Wide_Env_Output_Suffix & "/"
     & Anystrings_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib/" & external ("STRING_TYPE", "standard") & Wide_Env_Output_Suffix;

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("ANYSTRING_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Anystrings_Config.Ada_Compiler_Switches & ("-gnatyM120", "-gnat2022");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

    package Format is
      for Width ("Ada") use "120";
      for Charset ("Ada") use "utf-8";
   end Format;

   package Documentation is
      for Style use "leading";
   end Documentation;
end Anystrings;
