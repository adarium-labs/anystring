[DOCUMENT]
TITLE: String_Types Facade Split — Functional Requirements
REQ_PREFIX: FUNC-FACADE-

[GRAMMAR]
ELEMENTS:
- TAG: REQUIREMENT
  FIELDS:
  - TITLE: UID
    TYPE: String
    REQUIRED: True
