with "config/anystrings_examples_config.gpr";
project Anystrings_Examples is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Anystrings_Examples_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("anystrings_examples.adb");

   package Compiler is
      for Default_Switches ("Ada") use Anystrings_Examples_Config.Ada_Compiler_Switches & ("-gnatyM120", "-gnat2012");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   package Format is
      for Width ("Ada") use "120";
      for Charset ("Ada") use "utf-8";
   end Format;
end Anystrings_Examples;
