with "config/anystrings_examples_config.gpr";
project Anystrings_Examples is

   type String_Type_Choice is
     ("standard", "wide_string", "wide_wide_string", "uxstring", "custom");
   String_Type : String_Type_Choice := external ("STRING_TYPE", "standard");

   Wide_Env_Output_Suffix := "";
   case String_Type is
      when "wide_string" | "wide_wide_string" =>
         Wide_Env_Output_Suffix := "/" & external ("ANYSTRING_WIDE_ENV_ENCODING", "utf_8");
      when others =>
         null;
   end case;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use
     "obj/" & external ("STRING_TYPE", "standard") & Wide_Env_Output_Suffix & "/"
     & Anystrings_Examples_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin/" & external ("STRING_TYPE", "standard") & Wide_Env_Output_Suffix;
   for Main use
     ("anystrings_examples.adb",
      "anystrings_env_encoding_regression.adb",
      "anystrings_utf_8_demo.adb");

   package Compiler is
      for Default_Switches ("Ada") use Anystrings_Examples_Config.Ada_Compiler_Switches & ("-gnatyM120", "-gnat2012");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   package Format is
      for Width ("Ada") use "120";
      for Charset ("Ada") use "utf-8";
   end Format;
end Anystrings_Examples;
