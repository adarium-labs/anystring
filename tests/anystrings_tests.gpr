with "config/anystrings_tests_config.gpr";
project Anystrings_Tests is

   type String_Type_Choice is
     ("standard", "wide_string", "wide_wide_string", "uxstring", "vss", "custom");
   String_Type : String_Type_Choice := external ("STRING_TYPE", "standard");

   Wide_Env_Output_Suffix := "";
   case String_Type is
      when "wide_string" | "wide_wide_string" =>
         Wide_Env_Output_Suffix :=
           "/" & external ("ANYSTRING_WIDE_ENV_ENCODING", "utf_8");
      when others =>
         null;
   end case;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use
     "obj/" & external ("STRING_TYPE", "standard") & Wide_Env_Output_Suffix & "/"
     & Anystrings_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin/" & external ("STRING_TYPE", "standard") & Wide_Env_Output_Suffix;
   for Main use ("anystrings_test_runner.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Anystrings_Tests_Config.Ada_Compiler_Switches & ("-gnatyM120", "-gnat2012");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Format is
      for Width ("Ada") use "120";
      for Charset ("Ada") use "utf-8";
   end Format;

end Anystrings_Tests;
