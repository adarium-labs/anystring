--  Generator for src/anystrings_ucd_case.ads/.adb (see tools/ucd/README.md).
--  Plain GNAT project with no dependencies: build with gprbuild, no Alire.
project Ucd_Generator is

   for Source_Dirs use ("src/");
   for Object_Dir use "obj/";
   for Exec_Dir use "bin/";
   for Main use ("ucd_generator.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2012", "-gnatwa", "-g");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Ucd_Generator;
